---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "subtitle" : "{{ post.subtitle | escape }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}{% if site.data.books.size > 0 %}{% if site.posts.size > 0 %},{% endif %}
  {% for book in site.data.books %}
    {
      "title"    : "{{ book.title | escape }}",
      "subtitle" : "{{ book.author | escape }}",
      "description" : "{{ book.description | escape }}",
      "tags"     : "藏书, 电子书",
      "url"      : "{{ site.baseurl }}/docs/{{ book.dir }}/",
      "date"     : ""
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}{% endif %}
]
